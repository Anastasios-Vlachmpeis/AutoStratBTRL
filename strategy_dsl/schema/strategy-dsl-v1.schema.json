{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.local/schema/strategy-dsl-v1.schema.json",
  "title": "Axiom Strategy DSL v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dsl_version", "strategy_id", "dna_hash", "compiler", "lineage", "scope", "features", "entry", "exit", "cooldown", "target", "session", "risk", "warmup_bars"],
  "properties": {
    "dsl_version": { "const": "1.0.0" },
    "strategy_id": { "type": "string", "pattern": "^DSL1-[a-f0-9]{24}$" },
    "dna_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_version", "schema_sha256", "semantic_sha256"],
      "properties": {
        "semantic_version": { "const": "1.0.0" },
        "schema_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "semantic_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["trial_id", "generation", "parent_strategy_id", "creation_seed"],
      "properties": {
        "trial_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "parent_strategy_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,120}$" },
        "creation_seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "universe_id", "universe_sha256", "symbols", "minimum_dollar_volume", "allow_long", "allow_short"],
      "properties": {
        "mode": { "const": "time_series" },
        "universe_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$" },
        "universe_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "symbols": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$" } },
        "minimum_dollar_volume": { "type": "number", "minimum": 0, "maximum": 1000000000000 },
        "allow_long": { "type": "boolean" },
        "allow_short": { "type": "boolean" }
      }
    },
    "features": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/node" }
    },
    "entry": { "$ref": "#/$defs/entry" },
    "exit": { "$ref": "#/$defs/exit" },
    "cooldown": {
      "type": "object", "additionalProperties": false, "required": ["bars"],
      "properties": { "bars": { "type": "integer", "minimum": 0, "maximum": 78 } }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["position_size", "max_strategy_gross", "per_symbol_cap", "normalization", "ranking", "reverse_on_opposite"],
      "properties": {
        "position_size": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_strategy_gross": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.005 },
        "per_symbol_cap": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.005 },
        "normalization": { "enum": ["equal_weight", "unit"] },
        "ranking": { "const": "none" },
        "reverse_on_opposite": { "type": "boolean" }
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["timezone", "regular_hours_only", "entry_cutoff", "flatten_at"],
      "properties": {
        "timezone": { "const": "America/New_York" },
        "regular_hours_only": { "const": true },
        "entry_cutoff": { "type": "string", "pattern": "^(0[9]|1[0-5]):[0-5][0-9]$" },
        "flatten_at": { "type": "string", "pattern": "^(0[9]|1[0-5]):[0-5][0-9]$" }
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["stop_loss_bps", "max_turnover_per_day", "max_concurrent_symbols", "minimum_data_coverage", "flatten_on_unhealthy_data"],
      "properties": {
        "stop_loss_bps": { "type": ["number", "null"], "minimum": 1, "maximum": 1000 },
        "max_turnover_per_day": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        "max_concurrent_symbols": { "type": "integer", "minimum": 1, "maximum": 40 },
        "minimum_data_coverage": { "type": "number", "minimum": 0.9, "maximum": 1 },
        "flatten_on_unhealthy_data": { "const": true }
      }
    },
    "warmup_bars": { "type": "integer", "minimum": 0, "maximum": 252 }
  },
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "inputs", "params"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
        "op": {
          "enum": [
            "open", "high", "low", "close", "volume", "vwap_proxy", "constant",
            "simple_return", "log_return", "gap_return", "sma", "ema", "price_average_distance",
            "moving_average_difference", "slope", "zscore", "bollinger_distance",
            "rolling_high_distance", "rolling_low_distance", "rate_of_change", "true_range", "atr",
            "realized_volatility", "bar_range_percentile", "relative_volume", "minutes_since_open",
            "minutes_until_close", "is_finite", "is_missing", "add", "subtract", "multiply", "safe_divide",
            "absolute", "negate", "safe_log", "greater_than", "greater_equal", "less_than", "less_equal",
            "equal", "and", "or", "not"
          ]
        },
        "inputs": { "type": "array", "maxItems": 4, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" } },
        "params": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "value": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
            "window": { "type": "integer", "minimum": 2, "maximum": 252 },
            "lag": { "type": "integer", "minimum": 0, "maximum": 252 },
            "annualization": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "epsilon": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.01 }
          }
        }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["long", "short"],
      "properties": {
        "long": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,47}$" },
        "short": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,47}$" }
      }
    },
    "exit": {
      "type": "object", "additionalProperties": false, "required": ["flat"],
      "properties": { "flat": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,47}$" } }
    }
  }
}
