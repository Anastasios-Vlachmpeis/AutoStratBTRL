# Copy this file to .dev.vars for authenticated local mutation requests.
# Generate a long random value; never commit the real token.
ADMIN_TOKEN=replace-with-a-long-random-secret
ADMIN_TOKEN_KEY_ID=local-current
# During rotation only; remove after every browser session has moved.
ADMIN_TOKEN_PREVIOUS=replace-with-the-previous-long-random-secret
ADMIN_TOKEN_PREVIOUS_KEY_ID=local-previous
ENVIRONMENT=local
TRADING_ENVIRONMENT=paper
BROKER_ACCOUNT_CLASS=paper
DATA_FEED_VERSION=alpaca-iex-5min-adjusted-v1
CONTROL_PLANE_MODE=legacy
NORMALIZED_STORAGE_ENABLED=false
NORMALIZED_READ_ENABLED=false
MARKET_DATA_MODE=off
ORCHESTRATION_MODE=observe
ALPACA_API_KEY=replace-with-your-paper-key-id
ALPACA_API_SECRET=replace-with-your-paper-secret-key
ALPACA_BROKER_MODE=shadow
ALPACA_TRADING_ENABLED=false
ALPACA_CANARY_TRADING_ENABLED=false
ALPACA_LONG_TRADING_ENABLED=false
ALPACA_SHORT_TRADING_ENABLED=false
# Frozen Plan 09 safety defaults. Keep all execution switches false until the
# shadow comparison and explicit canary checks pass.
ALPACA_MAX_STRATEGY_PCT=0.005
ALPACA_MAX_PORTFOLIO_PCT=0.10
ALPACA_MAX_SYMBOL_PCT=0.02
ALPACA_MAX_CLUSTER_PCT=0.04
ALPACA_DAILY_LOSS_HALT_PCT=0.005
ALPACA_ENTRY_CUTOFF_MINUTES=30
ALPACA_FLATTEN_START_MINUTES=10
ALPACA_FLAT_TARGET_MINUTES=5
ALPACA_MAX_ORDER_PCT=0.02
# Optional remote Backtrader service. Start in shadow, use legacy for an
# immediate rollback, and switch to backtrader only after parity review.
BACKTEST_SERVICE_URL=https://your-cloud-run-service.run.app
BACKTEST_SERVICE_SECRET=replace-with-a-second-long-random-secret
BACKTEST_SERVICE_KEY_ID=local-current
# Cloud Run may accept this previous key during a bounded rotation window.
BACKTEST_SERVICE_PREVIOUS_SECRET=replace-with-the-previous-backtest-secret
BACKTEST_SERVICE_PREVIOUS_KEY_ID=local-previous
BACKTEST_CALLBACK_SECRET=replace-with-a-distinct-future-callback-secret
BACKTEST_ENGINE=shadow
COST_CONTROL_ENABLED=false
MONTHLY_BUDGET_LIMIT_USD=50
MONTHLY_FIXED_COST_USD=0
COST_TELEMETRY_MAX_AGE_MS=21600000
