{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "axiom-strategy-foundry",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AXIOM_LAB",
        "class_name": "AxiomLab"
      }
    ]
  },
  "exports": {
    "AxiomLab": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["* * * * *", "0 * * * *"]
  },
  "vars": {
    "ORCHESTRATION_MODE": "observe",
    "CONTROL_PLANE_MODE": "legacy",
    "NORMALIZED_STORAGE_ENABLED": "false",
    "NORMALIZED_READ_ENABLED": "false",
    "MARKET_DATA_MODE": "off",
    "ALPACA_DATA_FEED": "iex",
    "ALPACA_TRADING_ENABLED": "false",
    "ALPACA_SHORT_TRADING_ENABLED": "false",
    "ALPACA_MAX_STRATEGY_PCT": "0.02",
    "ALPACA_MAX_PORTFOLIO_PCT": "0.20",
    "BACKTEST_ENGINE": "shadow",
    "RESEARCH_AUTORUN_ENABLED": "true",
    "RESEARCH_AUTORUN_SAMPLED_GENOMES": "32",
    "RESEARCH_AUTORUN_CHALLENGERS": "8",
    "RESEARCH_BUDGET_STATUS": "healthy"
  },
  "observability": {
    "enabled": true
  }
}
