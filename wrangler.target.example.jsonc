{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "axiom-strategy-foundry",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "AXIOM_LAB", "class_name": "AxiomLab" }]
  },
  "exports": {
    "AxiomLab": { "type": "durable-object", "storage": "sqlite" }
  },
  "d1_databases": [{
    "binding": "AXIOM_DB",
    "database_name": "axiom-control",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "AXIOM_ARTIFACTS",
    "bucket_name": "axiom-private-artifacts",
    "preview_bucket_name": "axiom-private-artifacts-preview"
  }],
  "queues": {
    "producers": [{ "binding": "AXIOM_JOBS", "queue": "axiom-jobs" }],
    "consumers": [{
      "queue": "axiom-jobs",
      "max_batch_size": 10,
      "max_batch_timeout": 5,
      "max_retries": 5,
      "dead_letter_queue": "axiom-jobs-dlq"
    }]
  },
  "triggers": { "crons": ["* * * * *", "0 * * * *"] },
  "vars": {
    "ORCHESTRATION_MODE": "observe",
    "CONTROL_PLANE_MODE": "dual_write",
    "NORMALIZED_STORAGE_ENABLED": "true",
    "NORMALIZED_READ_ENABLED": "false",
    "MARKET_DATA_MODE": "shadow",
    "ALPACA_DATA_FEED": "iex",
    "ALPACA_BROKER_MODE": "shadow",
    "ALPACA_TRADING_ENABLED": "false",
    "ALPACA_CANARY_TRADING_ENABLED": "false",
    "ALPACA_LONG_TRADING_ENABLED": "false",
    "ALPACA_SHORT_TRADING_ENABLED": "false",
    "ALPACA_MAX_STRATEGY_PCT": "0.005",
    "ALPACA_MAX_PORTFOLIO_PCT": "0.10",
    "ALPACA_MAX_SYMBOL_PCT": "0.02",
    "ALPACA_MAX_CLUSTER_PCT": "0.04",
    "ALPACA_DAILY_LOSS_HALT_PCT": "0.005",
    "ALPACA_ENTRY_CUTOFF_MINUTES": "30",
    "ALPACA_FLATTEN_START_MINUTES": "10",
    "ALPACA_FLAT_TARGET_MINUTES": "5",
    "ALPACA_MAX_ORDER_PCT": "0.02",
    "BACKTEST_ENGINE": "shadow",
    "BACKTEST_REQUIRE_IMAGE_DIGEST": "true"
  },
  "observability": { "enabled": true }
}
